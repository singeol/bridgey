"welcome.title" = "Welcome to Bridgey";
"welcome.body" = "Keep your Mac and phone on the same local network. Choose a device, compare the pairing code, and confirm it on both devices. Optional permissions are requested only when you use the related feature.";
"welcome.continue" = "Get started";
"drop.title" = "Drop a file here to send";
"drop.open" = "Open file drop window";
"drop.detail" = "This window stays open while you switch to Finder.";
"drop.ready" = "Drop one file anywhere in this area";
"drop.unavailable" = "Connect an Android device and enable File transfer first.";
"welcome.permissions" = "Bridgey needs Local Network access to find your phone. Notifications, for Android notifications and calls, and Automation, for Music or Spotify, are optional and requested only when you turn those features on. Review them in Settings, Permissions.";
"permissions.title" = "Permissions";
"permissions.intro" = "Bridgey asks for access only when a feature needs it. Denying optional access turns off only that feature.";
"permissions.localNetwork.name" = "Local Network";
"permissions.localNetwork.why" = "Required to find your phone and connect to it directly on your network. macOS asks the first time Bridgey looks for devices.";
"permissions.notifications.name" = "Notifications";
"permissions.notifications.why" = "Optional. Shows Android notifications, calls, and Find Device alerts on this Mac.";
"permissions.automation.name" = "Automation";
"permissions.automation.why" = "Optional. Lets Bridgey control Music or Spotify after you choose a player under Media. macOS asks the first time.";
"permissions.notUsed" = "Bridgey does not use location, contacts, camera, microphone, screen recording, Accessibility, Input Monitoring, or Full Disk Access.";
"permissions.allowed" = "Allowed";
"permissions.notAllowed" = "Not allowed";
"permissions.allow" = "Allow";
"permissions.open" = "Open Settings";
"reset.title" = "Reset Bridgey on this Mac";
"reset.summary" = "Deletes paired phones, settings, notification history, and the transfer list on this Mac.";
"reset.button" = "Reset Bridgey…";
"reset.confirmTitle" = "Reset Bridgey on this Mac?";
"reset.confirmMessage" = "Deleted: paired phones and their keys, all settings and per-device choices, keyboard shortcuts, media settings, notification history, mirrored notifications in Notification Center, and the transfer list. The welcome guide shows again.\n\nKept: received files, this Mac’s identity, and launch at login. Your phones keep their record of this Mac until you forget it there.";

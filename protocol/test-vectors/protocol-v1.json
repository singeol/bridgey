    {"name": "html missing", "plaintext": {"version": 1, "text": "x"}, "expect": "reject"},
    {"name": "version 2", "plaintext": {"version": 2, "text": "x", "html": "<p>x</p>"}, "expect": "reject"},
    {"name": "version as a string", "plaintext": {"version": "1", "text": "x", "html": "<p>x</p>"}, "expect": "reject"},
    {"name": "version as a boolean", "plaintext": {"version": true, "text": "x", "html": "<p>x</p>"}, "expect": "reject"},
    {"name": "text as a number", "plaintext": {"version": 1, "text": 5, "html": "<p>x</p>"}, "expect": "reject"},
    {"name": "not JSON", "plaintextString": "<p>x</p>", "expect": "reject"}
  ]
}

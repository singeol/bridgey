{
  "protocol": "Bridgey Protocol v1, native newline-delimited JSON transport",
  "contractVersion": 1,
  "status": "Describes the 0.6 clients. Proposed to be frozen at 1.0; see docs/protocol.md, Version 1 compatibility contract.",
  "directions": {
    "either": "Both clients send it.",
    "android-to-mac": "Only the Android client sends it; only the macOS client handles it.",
    "mac-to-android": "Only the macOS client sends it; only the Android client handles it."
  },
  "transport": {
    "framing": "One strict RFC 8259 JSON object per line, UTF-8, terminated by LF. One CR right before the LF is ignored.",
    "maxFrameBytes": 65536,
    "maxJsonDepth": 32,
    "discovery": "_bridgey._tcp",
    "onMalformedFrame": "Close the session before dispatch: oversized or unterminated frame, invalid UTF-8, not a strict JSON object, nested deeper than maxJsonDepth, a missing kind or sessionId, or an envelope field of the wrong type.",
    "onUnknownKind": "Ignore the message and keep the session.",
    "onUndecryptablePayload": "Close the session, except quick.request, quick.result and media.state, which are dropped.",
    "replayWindow": "Per session, the most recent 256 accepted messageId values."
  },
  "envelope": {
    "kind": { "type": "string", "required": true, "note": "1 to 64 bytes" },
    "sessionId": { "type": "string", "required": true, "note": "at most 128 bytes; empty only in a pairing.cancel sent before the session ID is known" },
    "messageId": { "type": "string", "required": false, "note": "UUID; required by every message that uses the replay window. An empty or null optional string counts as absent" },
    "deviceId": { "type": "string", "required": false },
    "deviceName": { "type": "string", "required": false },
    "publicKey": { "type": "string", "required": false, "note": "base64 X9.63 P-256 ephemeral key" },
    "identityKey": { "type": "string", "required": false, "note": "base64 P-256 long-term signing key" },
    "proof": { "type": "string", "required": false, "note": "base64 HMAC-SHA-256 confirmation" },
    "signature": { "type": "string", "required": false, "note": "base64 P-256 signature over the pairing transcript" },
    "nonce": { "type": "string", "required": false, "note": "base64 12-byte AES-GCM nonce" },
    "ciphertext": { "type": "string", "required": false, "note": "base64 AES-GCM ciphertext followed by the 16-byte tag" },
    "transferId": { "type": "string", "required": false, "note": "UUID of a file transfer" },
    "sequence": { "type": "integer", "required": false, "note": "file chunk sequence, from 0; an integral JSON number within plus or minus 2^53 - 1 (1.0 and 1e2 are integers)" }
  },
  "features": [
    { "key": "clipboard", "requiredInMap": true },
    { "key": "files", "requiredInMap": true },
    { "key": "notifications", "requiredInMap": true },
    { "key": "battery", "requiredInMap": true },
    { "key": "find_device", "requiredInMap": true },
    { "key": "ping", "requiredInMap": false },
    { "key": "links", "requiredInMap": false },
    { "key": "media", "requiredInMap": false },
    { "key": "calls", "requiredInMap": false }
  ],
  "messages": [
    { "kind": "pairing.offer", "direction": "either", "features": [], "encrypted": false,
      "envelope": ["sessionId", "deviceId", "deviceName", "publicKey"],
      "replies": ["pairing.answer"],
      "notes": "Sent by the side that opens the connection. sessionId is a new UUID." },
    { "kind": "pairing.answer", "direction": "either", "features": [], "encrypted": false,
      "envelope": ["sessionId", "deviceId", "deviceName", "publicKey"] },
    { "kind": "pairing.confirm", "direction": "either", "features": [], "encrypted": false,
      "envelope": ["sessionId", "deviceId", "identityKey", "proof", "signature"],
      "notes": "Sent after the user confirms the code, or at once when the peer is already trusted. The receiver checks the stored identity key." },
    { "kind": "pairing.cancel", "direction": "either", "features": [], "encrypted": false,
      "envelope": ["sessionId"],
      "notes": "Ends the current session." },
    { "kind": "heartbeat.ping", "direction": "either", "features": [], "encrypted": false,
      "envelope": ["sessionId", "messageId"],
      "replies": ["heartbeat.pong"],
      "notes": "Sent every 10 seconds while connected. Once a peer has sent heartbeat.ping or heartbeat.pong, 30 seconds without any message from it closes the session." },
    { "kind": "heartbeat.pong", "direction": "either", "features": [], "encrypted": false,
      "envelope": ["sessionId", "messageId"],
      "notes": "messageId repeats the ping's messageId." },
    { "kind": "features.update", "direction": "either", "features": [], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "features": "object of feature key to boolean; keys with requiredInMap must be present" },
      "notes": "Sent after pairing and whenever local policy changes. A feature is available only when both peers report true." },
    { "kind": "clipboard.update", "direction": "either", "features": ["clipboard"], "encrypted": true, "replay": "messageId",
      "maxPlaintextBytes": 32768,
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "(raw)": "UTF-8 text, not JSON, not empty" },
      "replies": ["clipboard.ack", "clipboard.rejected"] },
    { "kind": "clipboard.rich", "direction": "either", "features": ["clipboard"], "encrypted": true, "replay": "messageId",
      "maxPlaintextBytes": 32768,
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "text": "string, not empty", "html": "string, not empty" },
      "replies": ["clipboard.ack", "clipboard.rejected"],
      "notes": "text plus html at most 32,768 UTF-8 bytes." },
    { "kind": "clipboard.ack", "direction": "either", "features": ["clipboard"], "encrypted": false,
      "envelope": ["sessionId", "messageId"],
      "notes": "messageId repeats the acknowledged message's messageId." },
    { "kind": "clipboard.rejected", "direction": "either", "features": ["clipboard"], "encrypted": false,
      "envelope": ["sessionId", "messageId"],
      "notes": "Clipboard is off on the receiver; it then resends features.update." },
    { "kind": "battery.update", "direction": "either", "features": ["battery"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "level": "integer, 0 to 100", "isCharging": "boolean" } },
    { "kind": "ping.request", "direction": "either", "features": ["ping"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1" },
      "replies": ["ping.ack"] },
    { "kind": "ping.ack", "direction": "either", "features": ["ping"], "encrypted": false,
      "envelope": ["sessionId", "messageId"],
      "notes": "messageId repeats the request's messageId." },
    { "kind": "find.start", "direction": "either", "features": ["find_device"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "alertId": "string, \"active\"" },
      "replies": ["find.started", "find.stopped"] },
    { "kind": "find.stop", "direction": "either", "features": ["find_device"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "alertId": "string, \"active\"" },
      "replies": ["find.stopped"] },
    { "kind": "find.started", "direction": "either", "features": ["find_device"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "alertId": "string, \"active\"" } },
    { "kind": "find.stopped", "direction": "either", "features": ["find_device"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "alertId": "string, \"active\"" } },
    { "kind": "notifications.post", "direction": "android-to-mac", "features": ["notifications"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": {
        "packageName": "string, 1 to 256 characters",
        "applicationName": "string, 1 to 128 characters",
        "notificationId": "string, opaque, at most 512 characters",
        "title": "string, at most 1,024 characters",
        "text": "string, at most 8,192 characters; title or text is not empty",
        "timestamp": "integer, Unix milliseconds",
        "applicationIcon": "string, optional, base64 PNG, at most 28,672 characters",
        "callType": "string, optional: incoming, ongoing, screening or unknown",
        "actions": "array, at most 4 of {actionToken: 64 lowercase hex characters, title: at most 64 characters, allowsReply: boolean}"
      } },
    { "kind": "notifications.remove", "direction": "android-to-mac", "features": ["notifications"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "notificationId": "string, 1 to 512 characters" } },
    { "kind": "notifications.dismiss", "direction": "mac-to-android", "features": ["notifications"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "notificationId": "string, 1 to 512 characters" } },
    { "kind": "notifications.action", "direction": "mac-to-android", "features": ["notifications"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": {
        "notificationId": "string, 1 to 512 characters",
        "actionToken": "string, 64 lowercase hex characters from the matching notifications.post",
        "replyText": "string, optional, at most 4,096 characters"
      } },
    { "kind": "calls.request", "direction": "mac-to-android", "features": ["calls"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "number": "string, 3 to 15 digits with an optional leading +; spaces, parentheses, dots and hyphens are removed" },
      "replies": ["calls.started", "calls.confirmation_required", "calls.rejected"],
      "notes": "Android accepts at most one request every three seconds." },
    { "kind": "calls.started", "direction": "android-to-mac", "features": ["calls"], "encrypted": false,
      "envelope": ["sessionId", "messageId"],
      "notes": "messageId repeats the request's messageId." },
    { "kind": "calls.confirmation_required", "direction": "android-to-mac", "features": ["calls"], "encrypted": false,
      "envelope": ["sessionId", "messageId"],
      "notes": "messageId repeats the request's messageId." },
    { "kind": "calls.rejected", "direction": "android-to-mac", "features": ["calls"], "encrypted": false,
      "envelope": ["sessionId", "messageId"],
      "notes": "messageId repeats the request's messageId." },
    { "kind": "files.offer", "direction": "either", "features": ["files"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "transferId", "nonce", "ciphertext"],
      "payload": {
        "transferId": "string, UUID, equal to the envelope transferId",
        "name": "string, not empty; receivers keep only the last path component",
        "mimeType": "string",
        "size": "integer, 0 to 10,737,418,240 bytes",
        "sha256": "string, base64 of the 32-byte SHA-256 of the file"
      },
      "replies": ["files.accept", "files.rejected"],
      "notes": "The envelope transferId lets a receiver with files off reply files.rejected without decrypting." },
    { "kind": "files.accept", "direction": "either", "features": ["files"], "encrypted": false,
      "envelope": ["sessionId", "transferId"] },
    { "kind": "files.rejected", "direction": "either", "features": ["files"], "encrypted": false,
      "envelope": ["sessionId", "transferId"],
      "notes": "File transfer is off on the receiver; it then resends features.update." },
    { "kind": "files.chunk", "direction": "either", "features": ["files"], "encrypted": true, "replay": "messageId",
      "maxPlaintextBytes": 24576,
      "envelope": ["sessionId", "messageId", "transferId", "sequence", "nonce", "ciphertext"],
      "payload": { "(raw)": "file bytes" },
      "notes": "sequence starts at 0 and increases by one without gaps." },
    { "kind": "files.chunk.ack", "direction": "android-to-mac", "features": ["files"], "encrypted": false,
      "envelope": ["sessionId", "transferId", "sequence"],
      "notes": "Cumulative. The Mac keeps at most 64 chunks unacknowledged." },
    { "kind": "files.complete", "direction": "either", "features": ["files"], "encrypted": true, "replay": "messageId",
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "transferId": "string, UUID", "sha256": "string, base64 SHA-256 of all bytes" },
      "replies": ["files.complete.ack"] },
    { "kind": "files.complete.ack", "direction": "either", "features": ["files"], "encrypted": false,
      "envelope": ["sessionId", "transferId"],
      "notes": "Sent after the byte count and hash are verified and the file is saved." },
    { "kind": "files.cancel", "direction": "either", "features": ["files"], "encrypted": false,
      "envelope": ["sessionId", "transferId"],
      "replies": ["files.cancel.ack"],
      "notes": "Idempotent. Allowed even after the feature is turned off." },
    { "kind": "files.cancel.ack", "direction": "either", "features": ["files"], "encrypted": false,
      "envelope": ["sessionId", "transferId"] },
    { "kind": "quick.request", "direction": "either", "features": ["links", "media"], "encrypted": true, "replay": "messageId, then a per-feature sequence",
      "maxPlaintextBytes": 8192,
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": {
        "version": "integer, 1",
        "requestId": "string, UUID",
        "feature": "string, links or media",
        "action": "string; links: offer; media (Android to Mac only): toggle, pause, next, previous, seek, volume",
        "value": "string; links: http(s) URL of at most 4,096 bytes; seek: integer seconds 0 to 604800; volume: integer 0 to 100",
        "sequence": "integer, 1 to 9007199254740991, increasing per feature within the session"
      },
      "replies": ["quick.result"] },
    { "kind": "quick.result", "direction": "either", "features": ["links", "media"], "encrypted": true, "replay": "messageId",
      "maxPlaintextBytes": 8192,
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "requestId": "string, the request's requestId", "feature": "string", "accepted": "boolean" } },
    { "kind": "media.state", "direction": "mac-to-android", "features": ["media"], "encrypted": true, "replay": "messageId",
      "maxPlaintextBytes": 32768,
      "envelope": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": {
        "version": "integer, 1",
        "player": "string, at most 64 characters",
        "title": "string, at most 256 characters",
        "artist": "string, at most 256 characters",
        "playing": "boolean",
        "position": "integer, 0 to 604800 seconds",
        "duration": "integer, 0 to 604800 seconds",
        "volume": "integer, 0 to 100",
        "detail": "string, at most 256 characters",
        "artwork": "string, optional, base64 JPEG of at most 16 KiB and 128 by 128 pixels"
      } }
  ]
}
